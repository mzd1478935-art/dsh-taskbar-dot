{
  "name": "dsh-taskbar-dot",
  "version": "0.2.1",
  "description": "Windows 任务栏完成蓝点：回合跑完在 DSH 图标右上角点一个小蓝点，可调大小、短促提示音、可关闭；系统 overlay 绘制，无常驻进程，0 token。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "TaskbarDot.exe",
    "TaskbarDot.cs",
    "scripts/build.ps1",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "taskbar",
    "badge",
    "windows",
    "notification"
  ],
  "license": "MIT"
}
